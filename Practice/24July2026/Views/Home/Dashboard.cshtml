@model List<_24July2026.Models.Schedule>

@{
    ViewData["Title"] = "Dashboard";
}

<h2>Dashboard</h2>

<h4>Welcome, @ViewBag.User!</h4>

<p>Hello @ViewBag.User, this is your dashboard.</p>

<hr />

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Subject</th>
            <th>Faculty</th>
            <th>Day</th>
            <th>Time</th>
            <th>Room</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var schedule in Model)
        {
            <tr>
                <td>@schedule.Subject</td>
                <td>@schedule.Faculty</td>
                <td>@schedule.Day</td>
                <td>@schedule.StartTime - @schedule.EndTime</td>
                <td>@schedule.RoomNo</td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Logout" class="btn btn-danger">Logout</a>
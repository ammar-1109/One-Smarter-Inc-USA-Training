@model List<Automobile>

@{
    ViewData["Title"] = "Automobile Entries";
}

<h2>Automobile Entries</h2>
<hr />

<p>
    <a asp-controller="Automobile" asp-action="Register" class="btn btn-primary">Register New Automobile</a>
</p>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No automobiles registered yet.</div>
}
else
{
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Vehicle ID</th>
                <th>Vehicle Name</th>
                <th>Brand</th>
                <th>Model Year</th>
                <th>Price</th>
                <th>Fuel Type</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.VehicleId</td>
                    <td>@item.VehicleName</td>
                    <td>@item.Brand</td>
                    <td>@item.ModelYear</td>
                    <td>@item.Price.ToString("C")</td>
                    <td>@item.FuelType</td>
                </tr>
            }
        </tbody>
    </table>
}

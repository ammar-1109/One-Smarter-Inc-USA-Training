@model List<_16July2026.Models.Employee>

<div class="text-center mb-4">
    <h1 class="display-4">Employee Details</h1>
</div>

<div class="mb-3">
    <a asp-action="Index" class="btn btn-primary">Employees</a>
    <a asp-action="Department" class="btn btn-success">Departments</a>
</div>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Department</th>
            <th>Salary</th>
            <th>Email</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var emp in Model)
        {
            <tr>
                <td>@emp.Id</td>
                <td>@emp.Name</td>
                <td>@emp.Department</td>
                <td>₹@emp.Salary</td>
                <td>@emp.Email</td>
            </tr>
        }
    </tbody>
</table>